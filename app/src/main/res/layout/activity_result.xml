<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface_light"
        app:title="@string/title_security_assessment"
        app:titleTextColor="@color/text_primary_light"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:elevation="2dp" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Primary Assessment Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_assessment_hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:id="@+id/layout_assessment_hero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="24dp">

                    <!-- Offline Badge if applicable -->
                    <TextView
                        android:id="@+id/tv_offline_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Offline Heuristic Analysis"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary_light"
                        android:background="@color/surface_variant_light"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:layout_marginBottom="12dp"
                        android:visibility="gone" />

                    <!-- Risk Icon + Title -->
                    <ImageView
                        android:id="@+id/iv_risk_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_risk_high"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tv_risk_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/risk_level_high"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textAlignment="center" />

                    <!-- Custom Risk Score Dial -->
                    <com.scamshield.app.ui.widget.RiskScoreView
                        android:id="@+id/risk_score_view"
                        android:layout_width="160dp"
                        android:layout_height="160dp"
                        android:layout_marginTop="16dp" />

                    <TextView
                        android:id="@+id/tv_risk_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:textSize="14sp"
                        android:lineSpacingExtra="3dp"
                        android:textAlignment="center"
                        android:textColor="@color/text_secondary_light" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Analyzed Content Snippet Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/divider_light"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_analyzed_type_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Analyzed Content"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/brand_primary"
                        android:textAllCaps="true" />

                    <TextView
                        android:id="@+id/tv_analyzed_snippet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary_light" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- "Why this was flagged" Indicators Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:text="@string/why_flagged_title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary_light" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_indicators"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <!-- "Recommended Next Action" Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/divider_light"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/recommended_action_title"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary_light" />

                    <TextView
                        android:id="@+id/tv_recommended_actions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/text_secondary_light" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- "Human Verification Required" Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/divider_light"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/human_verification_title"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary_light" />

                    <TextView
                        android:id="@+id/tv_human_verification"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/text_secondary_light" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Disclaimer -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:text="@string/disclaimer_safety"
                android:textSize="12sp"
                android:textColor="@color/text_tertiary_light"
                android:textAlignment="center" />

            <!-- User Feedback Card (Section 12: False Positive Handling) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/feedback_title"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary_light" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <Button
                            android:id="@+id/btn_feedback_helpful"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:text="@string/btn_feedback_helpful"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btn_feedback_incorrect"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="6dp"
                            android:text="@string/btn_feedback_incorrect"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btn_feedback_notsure"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="@string/btn_feedback_notsure"
                            android:textSize="12sp" />

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Advanced Cloud AI Rewarded Ad Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_rewarded_ai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/brand_primary"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/color_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_shield_check"
                            app:tint="@color/brand_primary"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="Deep Cloud AI Verification"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/brand_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:background="@color/risk_low_bg"
                            android:text="FREE"
                            android:textStyle="bold"
                            android:textSize="11sp"
                            android:textColor="@color/risk_low" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_rewarded_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Run an in-depth multi-model neural scan on this content for maximum certainty."
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary_light" />

                    <Button
                        android:id="@+id/btn_watch_rewarded_ad"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:backgroundTint="@color/brand_primary"
                        android:textColor="@color/white"
                        app:cornerRadius="12dp"
                        android:text="@string/btn_rewarded_ai_scan" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Adaptive AdMob Banner Container -->
    <FrameLayout
        android:id="@+id/result_banner_ad_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <!-- Bottom Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@color/surface_light"
        android:elevation="8dp">

        <Button
            android:id="@+id/btn_share_result"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/btn_share_result" />

        <Button
            android:id="@+id/btn_check_another"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/btn_check_another" />
    </LinearLayout>

</LinearLayout>
