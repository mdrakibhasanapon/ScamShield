<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/divider_light"
    app:cardBackgroundColor="@color/surface_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Header: App Icon, App Name, Time, and Risk Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/iv_app_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_network_traffic"
                app:tint="@color/brand_primary"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_app_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Super Flashlight HD"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary_light" />

                <TextView
                    android:id="@+id/tv_package_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="com.utility.superflashlight"
                    android:textSize="11sp"
                    android:textColor="@color/text_tertiary_light" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_risk_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="95/100"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/badge_risk_high" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="@color/divider_light" />

        <!-- Destination & Protocol Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_direction_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="⬆️ Upload 348 KB"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/brand_primary"
                android:background="@color/surface_variant_light" />

            <TextView
                android:id="@+id/tv_protocol_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="HTTPS (TLS)"
                android:textSize="11sp"
                android:textColor="@color/text_secondary_light"
                android:background="@color/surface_variant_light" />

            <TextView
                android:id="@+id/tv_timestamp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="Just now"
                android:textSize="11sp"
                android:textColor="@color/text_tertiary_light" />

        </LinearLayout>

        <!-- Remote Destination Target -->
        <TextView
            android:id="@+id/tv_destination_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="🌐 Destination: c2-exfil-node.xyz (194.87.142.18:4444)"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary_light" />

        <!-- Why Flagged / Threat Reason -->
        <TextView
            android:id="@+id/tv_threat_reason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Connecting to notorious C2/trojan port 4444. App is uploading device identifiers."
            android:textSize="12sp"
            android:textColor="@color/text_secondary_light"
            android:lineSpacingExtra="1dp" />

        <!-- Action / Recommendation (visible for threats) -->
        <TextView
            android:id="@+id/tv_recommended_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Action: Restrict background data permissions in Android Settings."
            android:textSize="11sp"
            android:textStyle="italic"
            android:textColor="@color/risk_high" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
