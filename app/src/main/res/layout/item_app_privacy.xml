<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/divider_light"
    app:cardBackgroundColor="@color/surface_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header: Icon, App Name & Risk Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/iv_app_icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_shield_check"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_app_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Application Name"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary_light" />

                <TextView
                    android:id="@+id/tv_pkg_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="com.example.app • Sideloaded"
                    android:textSize="11sp"
                    android:textColor="@color/text_tertiary_light" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_risk_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Clean"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/badge_risk_low"
                android:textColor="@color/risk_low" />
        </LinearLayout>

        <!-- Permission Indicators Flow/Row -->
        <LinearLayout
            android:id="@+id/layout_permission_pills"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/pill_mic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="🎙️ Mic"
                android:textSize="11sp"
                android:background="@drawable/badge_risk_attention"
                android:textColor="@color/risk_attention"
                android:visibility="gone" />

            <TextView
                android:id="@+id/pill_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="📍 Location"
                android:textSize="11sp"
                android:background="@drawable/badge_risk_attention"
                android:textColor="@color/risk_attention"
                android:visibility="gone" />

            <TextView
                android:id="@+id/pill_contacts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="👥 Contacts"
                android:textSize="11sp"
                android:background="@drawable/badge_risk_attention"
                android:textColor="@color/risk_attention"
                android:visibility="gone" />

            <TextView
                android:id="@+id/pill_camera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="📸 Camera"
                android:textSize="11sp"
                android:background="@drawable/badge_risk_low"
                android:textColor="@color/brand_primary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/pill_audio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="🔊 Audio"
                android:textSize="11sp"
                android:background="@drawable/badge_risk_low"
                android:textColor="@color/brand_primary"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Risk Reason / Security Note -->
        <TextView
            android:id="@+id/tv_risk_reason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Reason text"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/text_secondary_light" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_manage_app"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Manage Permissions"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_uninstall_app"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Uninstall"
                android:textSize="12sp"
                android:textColor="@color/risk_high"
                app:icon="@drawable/ic_delete_trash"
                app:iconTint="@color/risk_high"
                app:iconSize="16dp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
