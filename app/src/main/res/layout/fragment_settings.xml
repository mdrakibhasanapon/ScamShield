<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_settings"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary_light"
            android:layout_marginBottom="20dp" />

        <!-- Group: Appearance -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_group_appearance"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/brand_primary"
            android:textAllCaps="true"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_theme"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary_light" />

                <RadioGroup
                    android:id="@+id/rg_theme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <RadioButton
                        android:id="@+id/rb_theme_system"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary_light"
                        android:text="@string/theme_system" />

                    <RadioButton
                        android:id="@+id/rb_theme_light"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary_light"
                        android:text="@string/theme_light" />

                    <RadioButton
                        android:id="@+id/rb_theme_dark"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary_light"
                        android:text="@string/theme_dark" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Group: Privacy & Data Control -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_group_privacy"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/brand_primary"
            android:textAllCaps="true"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Save Scan History Toggle -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_save_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_save_history"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary_light"
                    android:checked="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_save_history_desc"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary_light"
                    android:layout_marginBottom="16dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider_light"
                    android:layout_marginBottom="16dp" />

                <!-- Real-Time Incoming SMS Interceptor Toggle -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_sms_shield_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_sms_shield"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary_light" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_sms_shield_desc"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary_light"
                    android:layout_marginBottom="16dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider_light"
                    android:layout_marginBottom="16dp" />

                <!-- Notify All SMS Toggle -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_notify_all_sms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_notify_all_sms"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary_light" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_notify_all_sms_desc"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary_light"
                    android:layout_marginBottom="16dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider_light"
                    android:layout_marginBottom="16dp" />

                <!-- Real-Time Download Watchdog Toggle -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_download_shield_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_download_shield"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary_light" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_download_shield_desc"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary_light"
                    android:layout_marginBottom="16dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider_light"
                    android:layout_marginBottom="16dp" />

                <!-- Notify Clean Downloads Toggle -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_notify_clean_downloads"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_notify_clean_downloads"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary_light" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_notify_clean_downloads_desc"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary_light"
                    android:layout_marginBottom="16dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider_light"
                    android:layout_marginBottom="16dp" />

                <!-- Offline Analysis Only Toggle -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_offline_only"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_offline_mode"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary_light" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_offline_mode_desc"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary_light"
                    android:layout_marginBottom="16dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider_light"
                    android:layout_marginBottom="16dp" />

                <!-- Delete All Local Data -->
                <Button
                    android:id="@+id/btn_delete_all_data"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_delete_all_data"
                    android:textColor="@color/risk_high"
                    app:strokeColor="@color/risk_high" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Group: About & Trust -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_group_about"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/brand_primary"
            android:textAllCaps="true"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- What happens to my data? -->
                <TextView
                    android:id="@+id/tv_what_happens_data"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:text="@string/settings_what_happens_data"
                    android:textSize="15sp"
                    android:textColor="@color/brand_primary"
                    android:textStyle="bold"
                    android:background="?attr/selectableItemBackground" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider_light" />

                <!-- Privacy Policy -->
                <TextView
                    android:id="@+id/tv_privacy_policy"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:text="@string/settings_privacy_policy"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary_light"
                    android:background="?attr/selectableItemBackground" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider_light" />

                <!-- Terms -->
                <TextView
                    android:id="@+id/tv_terms"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:text="@string/settings_terms"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary_light"
                    android:background="?attr/selectableItemBackground" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider_light" />

                <!-- Version -->
                <TextView
                    android:id="@+id/tv_version_info"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:text="Version 1.0.0 (Production)"
                    android:textSize="13sp"
                    android:textColor="@color/text_tertiary_light" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
