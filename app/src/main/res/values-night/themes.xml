<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark theme. -->
    <style name="Theme.ScamShield" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_variant</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        
        <item name="android:statusBarColor">@color/color_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/color_surface</item>
        <item name="android:windowLightNavigationBar">false</item>

        <item name="android:colorBackground">@color/color_bg</item>
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorSurfaceVariant">@color/color_surface_variant</item>
        <item name="colorOnSurface">@color/color_text_primary</item>
        <item name="android:textColorPrimary">@color/color_text_primary</item>
        <item name="android:textColorSecondary">@color/color_text_secondary</item>
        <item name="android:textColorHint">@color/color_text_tertiary</item>
        <item name="android:editTextColor">@color/color_input_text</item>

        <item name="cardViewStyle">@style/Widget.ScamShield.CardView.Dark</item>
        <item name="buttonStyle">@style/Widget.ScamShield.Button</item>
    </style>

    <style name="Widget.ScamShield.CardView.Dark" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/color_surface</item>
    </style>

    <style name="Widget.ScamShield.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Theme.ScamShield.Splash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">#070D18</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#070D18</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">#070D18</item>
    </style>
</resources>
