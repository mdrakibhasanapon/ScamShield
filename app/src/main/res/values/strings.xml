    <!-- Indicators -->
    <string name="indicator_urgency_title">Urgency &amp; Pressure Tactics</string>
    <string name="indicator_urgency_desc">The content pressures you to act immediately (e.g., threatened account suspension or arrest). Scammers use urgency to prevent careful verification.</string>

    <string name="indicator_financial_title">Financial / Gift Card Demand</string>
    <string name="indicator_financial_desc">Demands payment via non-standard or irreversible methods such as gift cards, wire transfer, or cryptocurrency.</string>

    <string name="indicator_credential_title">Credential Harvesting Attempt</string>
    <string name="indicator_credential_desc">Directly requests sensitive credentials, passwords, 2FA codes, PINs, or Social Security information.</string>

    <string name="indicator_impersonation_title">Brand / Institution Impersonation</string>
    <string name="indicator_impersonation_desc">Impersonates a well-known financial institution, delivery service, government agency, or tech support team.</string>

    <string name="indicator_url_anomaly_title">Deceptive / Anomalous URL</string>
    <string name="indicator_url_anomaly_desc">Contains deceptive URL patterns such as IP-based hosts, brand typosquatting, suspicious TLDs, or multiple redirection hops.</string>

    <string name="indicator_prize_title">Unsolicited Prize / Inheritance Claim</string>
    <string name="indicator_prize_desc">Promises unexpected lotteries, crypto airdrops, or inheritances requiring an upfront fee to claim.</string>

    <string name="indicator_delivery_title">Fake Parcel / Delivery Surcharge</string>
    <string name="indicator_delivery_desc">Claims a package cannot be delivered without an immediate fee payment or address confirmation.</string>

